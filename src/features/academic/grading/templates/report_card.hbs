<html lang='en'>

<head>
  <meta charset='UTF-8' />
  <meta name='viewport' content='width=device-width, initial-scale=1.0' />
  <title>Student Academic Standing</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: #333;
      background: #f5f5f5;
      padding: 40px;
    }

    .container {
      max-width: 900px;
      margin: auto;
      background: #fff;
      padding: 40px;
      border-radius: 10px;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
    }

    header {
      border-bottom: 2px solid #ddd;
      padding-bottom: 20px;
      margin-bottom: 30px;
    }

    header h1 {
      font-size: 30px;
      margin-bottom: 8px;
    }

    header p {
      color: #666;
    }

    section {
      margin-bottom: 40px;
    }

    h2 {
      margin-bottom: 20px;
      font-size: 20px;
      color: #111;
      padding-bottom: 8px;
    }

    .profile {
      display: grid;
      grid-template-columns: 160px 20px 1fr;
      row-gap: 12px;
      font-size: 15px;
      padding-left: 5px;
    }

    .label {
      font-weight: bold;
      color: #555;
    }

    .separator {
      color: #888;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }

    thead {
      background: #222;
      color: white;
    }

    th,
    td {
      border: 1px solid #ddd;
      padding: 12px;
      text-align: left;
      font-size: 14px;
    }

    tbody tr:nth-child(even) {
      background: #f8f8f8;
    }

    .summary-row {
      margin-top: 25px;
      padding-top: 15px;
      border-top: 2px dashed #eee;
      display: flex;
      justify-content: center;
      gap: 50px;
      font-size: 15px;
    }

    .summary-item {
      display: inline-block;
    }

    .summary-item strong {
      color: #555;
    }
  </style>
</head>

<body>

  <div class='container'>
    <header>
      <h1>Academic Standing Report</h1>
      <p>Student Performance Summary</p>
    </header>

    <main>
      <section>
        <h2>Student Profile</h2>
        <div class='profile'>
          <div class='label'>Student Name</div>
          <div class='separator'>:</div>
          <div>{{student.first_name}} {{student.last_name}}</div>

          <div class='label'>Student Number</div>
          <div class='separator'>:</div>
          <div>{{student.student_number}}</div>

          <div class='label'>Email</div>
          <div class='separator'>:</div>
          <div>{{student.email}}</div>
        </div>
      </section>

      <section>
        <h2>Curriculum Standing</h2>

        <table>
          <thead>
            <tr>
              <th>Block</th>
              <th>Subject</th>
              <th>Test</th>
              <th>Grade</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {{#each academicStanding}}
            {{#each subjects}}
            {{#each tests}}
            <tr>
              <td>{{../../block_id.name}}</td>
              <td>{{../subject_id.name}}</td>
              <td>{{test_id.name}}</td>
              <td>{{total_mark}}</td>
              <td>{{test_status}}</td>
            </tr>
            {{/each}}
            {{/each}}
            {{/each}}
          </tbody>
        </table>

        <div class="summary-row">
          {{#each academicStanding}}
          <div class="summary-item">
            <strong>Block :</strong> {{block_id.name}}
          </div>
          <div class="summary-item">
            <strong>Average :</strong> {{block_average}}
          </div>
          <div class="summary-item">
            <strong>Status :</strong> {{block_status}}
          </div>
          {{/each}}
        </div>

      </section>
    </main>
  </div>

</body>

</html>